# Server-side model provider configuration
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2

# Required shared application access gate (use a long random value; never commit real secrets)
ZALAM_ACCESS_TOKEN=replace-with-a-long-random-secret-at-least-24-characters

# Optional: exact HTTPS lab target; host must match the value below
ZALAM_LAB_TARGET_URL=https://your-owned-domain.example
ZALAM_LAB_ALLOWED_HOST=your-owned-domain.example
